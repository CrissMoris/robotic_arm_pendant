<?xml version="1.0" ?>
<!--
  Conveyor pick-and-place workcell (simulation only, static belts in this version).

  Robot: orion5_v166 + MC1, spawned with  -z 0.4  (base_link on top of the pedestal).
  Frame rule: Gazebo z = base_link z + 0.40.  Planning-scene copies of the belts live in
  orion5_interface/config/scenarios/conveyor.yaml (workcell:), the product under objects:.

  Object          size (x y z)        Gazebo pose (x y z)      base_link z
  pedestal        0.20 0.20 0.40      0.00  0.00 0.20         top at 0.00 (scene copy: top at -0.02)
  input_belt      0.30 0.60 0.05      0.45 -0.35 0.39         belt top 0.415 -> +0.015  (y -0.65..-0.05)
  output_belt     0.30 0.60 0.05      0.45  0.35 0.39         belt top 0.415 -> +0.015  (y +0.05..+0.65)
  product (box)   0.06 0.06 0.08      0.45 -0.30 0.455        centre 0.055, bottom 0.015 (dynamic, NOT a scene obstacle)
  place point                         0.45  0.30 0.455        centre 0.055 when resting on the output belt

  The product is a dynamic model: at PICK the bridge attaches it to the gripper link with the gazebo_ros_link_attacher
  plugin (kinematic fixed joint, not a physics grasp) and detaches it at PLACE; SCENE_RESET puts it back on the input
  belt. Belt motion (moving product) is not simulated in this version.
-->
<sdf version="1.7">
  <world name="conveyor">

    <!-- kinematic attach/detach services: /link_attacher_node/attach, /link_attacher_node/detach -->
    <plugin name="ros_link_attacher_plugin" filename="libgazebo_ros_link_attacher.so"/>

    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>1</static>
      <link name="ground_plane_link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <cast_shadows>0</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>

    <!-- Robot pedestal -->
    <model name="pedestal">
      <static>1</static>
      <pose>0 0 0.20 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.20 0.20 0.40</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.20 0.20 0.40</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Input belt (left of the robot, y negative): belt body on four legs; static in this version -->
    <model name="input_belt">
      <static>1</static>
      <pose>0.45 -0.35 0 0 0 0</pose>
      <link name="link">
        <collision name="body"><pose>0 0 0.39 0 0 0</pose><geometry><box><size>0.30 0.60 0.05</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="body_visual"><pose>0 0 0.39 0 0 0</pose><geometry><box><size>0.30 0.60 0.05</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
        <visual name="frame_visual"><pose>0 0 0.36 0 0 0</pose><geometry><box><size>0.34 0.64 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material></visual>
        <collision name="leg1"><pose> 0.13  0.28 0.175 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.35</length></cylinder></geometry></collision>
        <visual    name="leg1_v"><pose> 0.13  0.28 0.175 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.35</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="leg2"><pose> 0.13 -0.28 0.175 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.35</length></cylinder></geometry></collision>
        <visual    name="leg2_v"><pose> 0.13 -0.28 0.175 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.35</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="leg3"><pose>-0.13  0.28 0.175 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.35</length></cylinder></geometry></collision>
        <visual    name="leg3_v"><pose>-0.13  0.28 0.175 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.35</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="leg4"><pose>-0.13 -0.28 0.175 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.35</length></cylinder></geometry></collision>
        <visual    name="leg4_v"><pose>-0.13 -0.28 0.175 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.35</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <!-- Output belt (right of the robot, y positive) -->
    <model name="output_belt">
      <static>1</static>
      <pose>0.45 0.35 0 0 0 0</pose>
      <link name="link">
        <collision name="body"><pose>0 0 0.39 0 0 0</pose><geometry><box><size>0.30 0.60 0.05</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="body_visual"><pose>0 0 0.39 0 0 0</pose><geometry><box><size>0.30 0.60 0.05</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
        <visual name="frame_visual"><pose>0 0 0.36 0 0 0</pose><geometry><box><size>0.34 0.64 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material></visual>
        <collision name="leg1"><pose> 0.13  0.28 0.175 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.35</length></cylinder></geometry></collision>
        <visual    name="leg1_v"><pose> 0.13  0.28 0.175 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.35</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="leg2"><pose> 0.13 -0.28 0.175 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.35</length></cylinder></geometry></collision>
        <visual    name="leg2_v"><pose> 0.13 -0.28 0.175 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.35</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="leg3"><pose>-0.13  0.28 0.175 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.35</length></cylinder></geometry></collision>
        <visual    name="leg3_v"><pose>-0.13  0.28 0.175 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.35</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="leg4"><pose>-0.13 -0.28 0.175 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.35</length></cylinder></geometry></collision>
        <visual    name="leg4_v"><pose>-0.13 -0.28 0.175 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.35</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <!-- Product: manipulation target. Dynamic box 0.06 x 0.06 x 0.08 m, m = 0.1 kg (solid-box inertia). -->
    <model name="product">
      <static>0</static>
      <pose>0.45 -0.30 0.455 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>8.3e-05</ixx><iyy>8.3e-05</iyy><izz>6.0e-05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.06 0.06 0.08</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>100</kd><min_depth>0.001</min_depth></ode></contact></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.06 0.06 0.08</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>
    </model>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>2.2 -1.8 1.6 0 0.35 2.4</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
