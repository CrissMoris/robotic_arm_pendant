<?xml version="1.0"?>

<robot xmlns:xacro="http://wiki.ros.org/xacro" name="orion5_v166">

   <xacro:include filename="$(find orion5_description)/urdf/orion5_v166_arm.xacro"/>
   <xacro:include filename="$(find orion5_description)/urdf/transmissions.xacro"/>
   <xacro:include filename="$(find orion5_description)/urdf/gazebo_control.xacro"/>
   <xacro:include filename="$(find orion5_description)/urdf/colors.xacro"/>

   <link name="world"/>

   <joint name="world_fixed_joint" type="fixed">
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <parent link="world" />
      <child link="base_link" />
   </joint>

   <xacro:orion5_v166 />
   
   <xacro:transmissions />
   <xacro:gazebo_control />
   <xacro:colors />

</robot>
