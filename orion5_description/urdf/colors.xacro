<?xml version="1.0"?>

<robot xmlns:xacro="http://wiki.ros.org/xacro">

    <xacro:macro name="colors">

        <material name="black">
            <color rgba="0.2 0.2 0.2 1.0" />
        </material>
        <material name="gray">
            <color rgba="0.7 0.7 0.7 1.0" />
        </material>
        <material name="blue">
            <color rgba="0.1 0.5 0.7 1.0" />
        </material>

    </xacro:macro>

</robot>