                <mass value="1.0868"/>
                <inertia ixx="0.0084673" ixy="-4.0465e-05" ixz="-1.4163e-06" iyy="0.0014603" iyz="-0.00016568" izz="0.0081904"/>
            </inertial>
            <visual>
