        <joint name="joint_4" type="revolute">
            <origin xyz="0 0.427 0.018" rpy="-3.1416 0 0" />
            <parent link="link_3" />
            <child link="link_4" />
            <axis xyz="0 0 -1" />
            <limit lower="-3.14" upper="3.14" effort="200" velocity="1.57" />
            <dynamics damping="0.1" friction="0.1"/>
        </joint>

        <link name="link_4">
            <inertial>
                <origin rpy="0 0 0" xyz="0.00067229 -0.010802 0.051025"/>
                <mass value="0.50427"/>
                <inertia ixx="0.00065514" ixy="-1.9544e-06" ixz="1.7674e-07" iyy="0.00043345" iyz="2.2995e-06" izz="0.00063832"/>
