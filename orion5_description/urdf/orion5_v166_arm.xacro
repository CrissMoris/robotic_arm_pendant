            <collision>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://orion5_description/meshes/link_4.STL"/>
                </geometry>
            </collision>
        </link>

        <joint name="joint_5" type="revolute">
            <origin xyz="0 -0.052 0.053" rpy="1.5708 -0.7854 0" />
            <parent link="link_4" />
            <child link="link_5" />
            <axis xyz="0 0 -1" />
            <limit lower="-3.14" upper="3.14" effort="200" velocity="1.57" />
            <dynamics damping="0.1" friction="0.1"/>
        </joint>

        <link name="link_5">
