        <joint name="joint_6" type="revolute">
            <origin xyz="0.031289 0.031289 0.053" rpy="-1.5708 0 -0.7854" />
            <parent link="link_5" />
            <child link="link_6" />
            <axis xyz="0 0 -1" />
            <limit lower="-3.14" upper="3.14" effort="200" velocity="1.57" />
            <dynamics damping="0.1" friction="0.1"/>
