                <geometry>
                    <mesh filename="package://orion5_description/meshes/link_6.STL"/>
                </geometry>
            </collision>
        </link>

        <joint name="eef_fixed_joint" type="fixed">
            <origin rpy="0 0 0" xyz="0 0 0.047"/>
            <parent link="link_6"/>
            <child link="eef_link"/>
        </joint>

        <link name="eef_link">
            <inertial>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <mass value="0.00001"/>
                <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
            </inertial>
        </link>

        <!-- MoveIt planning tip (SRDF group orion5_arm: base_link -> eef_tcp_link) -->
        <joint name="eef_tcp_fixed_joint" type="fixed">
            <origin rpy="0 0 0" xyz="0 0 ${tcp_z}"/>
            <parent link="eef_link"/>
            <child link="eef_tcp_link"/>
        </joint>

        <link name="eef_tcp_link">
            <inertial>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <mass value="0.00001"/>
                <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
            </inertial>
        </link>

    </xacro:macro>

</robot>