<?xml version="1.0"?>

<robot xmlns:xacro="http://wiki.ros.org/xacro">

    <!-- tcp_z: offset of the MoveIt tip link (eef_tcp_link) from eef_link along +Z.
         0.0 for the bare arm; the MC1 robot xacro passes the gripper TCP offset. -->
    <xacro:macro name="orion5_v166" params="tcp_z:=0.0">

        <link name="base_link">
            <inertial>
                <origin rpy="0 0 3.92699081" xyz="0.0014872 0.025681 0.0015954"/>
                <mass value="0.43234"/>
                <inertia ixx="0.00085424" ixy="-4.256E-07" ixz="1.7204E-05" iyy="0.0014489" iyz="-3.1849E-07" izz="0.00085002"/>
            </inertial>
            <visual>
                <origin rpy="0 0 3.92699081" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://orion5_description/meshes/base_link.STL"/>
                </geometry>
                <material name="blue">
                </material>
            </visual>
            <collision>
                <origin rpy="0 0 3.92699081" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://orion5_description/meshes/base_link.STL"/>
                </geometry>
            </collision>
        </link>

        <joint name="joint_1" type="revolute">
            <origin xyz="0 0 0.05375" rpy="0 0 0.7853981" />
            <parent link="base_link" />
            <child link="link_1" />
            <axis xyz="0 0 -1" />
            <limit lower="-3.14" upper="3.14" effort="200" velocity="1.57" />
            <dynamics damping="0.1" friction="0.1"/>
        </joint>

        <link name="link_1">
            <inertial>
                <origin rpy="0 0 0" xyz="0.0032053 0.0032066 0.071258"/>
                <mass value="1.4977"/>
                <inertia ixx="0.0040548" ixy="-6.3827e-05" ixz="1.9488e-05" iyy="0.0040547" iyz="1.9457e-05" izz="0.003024"/>
            </inertial>
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://orion5_description/meshes/link_1.STL"/>
                </geometry>
                <material name="black">
                </material>
            </visual>
            <collision>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://orion5_description/meshes/link_1.STL"/>
                </geometry>
            </collision>
        </link>

        <joint name="joint_2" type="revolute">
            <origin xyz="0.044371 0.044371 0.06825" rpy="-1.5708 0 -0.7854" />
            <parent link="link_1" />
            <child link="link_2" />
            <axis xyz="0 0 -1" />
            <limit lower="-3.14" upper="3.14" effort="200" velocity="1.57" />
            <dynamics damping="0.1" friction="0.1"/>
        </joint>

        <link name="link_2">
            <inertial>
                <origin rpy="0 0 0" xyz="-0.011965 -0.20398 0.082482"/>
                <mass value="3.9537"/>
                <inertia ixx="0.14571" ixy="0.0011447" ixz="-8.9776e-05" iyy="0.0068268" iyz="-0.00039373" izz="0.14325"/>
            </inertial>
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://orion5_description/meshes/link_2.STL"/>
