        <link name="link_6">
            <inertial>
                <origin rpy="0 0 0" xyz="-0.00030609 -0.00064718 0.026501"/>
                <mass value="0.0029836"/>
                <inertia ixx="9.0087e-05" ixy="2.945e-08" ixz="-1.0412e-07" iyy="8.7872e-05" iyz="-9.2359e-08" izz="0.00013295"/>
            </inertial>
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://orion5_description/meshes/link_6.STL"/>
