<launch>

  <param name="robot_description" command="$(find xacro)/xacro --inorder $(find orion5_description)/urdf/orion5_v166_robot_mc1.xacro"/>
  
  <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" />
  
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
  
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find orion5_description)/rviz/display_robot_gripper.rviz" />

</launch>